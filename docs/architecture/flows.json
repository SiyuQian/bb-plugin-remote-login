  "nodes": [
    {
      "id": "cli",
      "col": 0,
      "row": 0,
      "kind": "host",
      "title": "OCI CLI 分支",
      "lines": [
        "官方 CLI 子进程 + 专属 Chrome",
        "网页与 8181 监听都在 host",
        "浏览器回调 host 本地 CLI"
      ]
    },
    {
      "id": "cliState",
      "col": 1,
      "row": 0,
      "kind": "store",
      "title": "CLI 私有会话文件",
      "lines": [
        "受保护 token / key",
        "完成后封存同一凭据代次",
        "不借用 Console 会话"
      ]
    },
    {
      "id": "cliVerify",
      "col": 2,
      "row": 0,
      "kind": "host",
      "title": "CLI 身份核验",
      "lines": [
        "官方 session validate",
        "同一快照发 SDK 签名请求",
        "精确核对预选 user / tenancy"
      ]
    },
    {
      "id": "cliRead",
      "col": 3,
      "row": 0,
      "kind": "server",
      "title": "受限 CLI 读取",
      "lines": [
        "accountRef 绑定原线程",
        "compartment / Sydney 实例",
        "固定请求、最多 25 行"
      ]
    },
    {
      "id": "console",
      "col": 0,
      "row": 1,
      "kind": "host",
      "title": "OCI Console 分支",
      "lines": [
        "独立 Chrome profile / context",
        "手机只控制这次登录页面",
        "交还时冻结输入与网络"
      ]
    },
    {
      "id": "webState",
      "col": 1,
      "row": 1,
      "kind": "store",
      "title": "保留同一浏览器 context",
      "lines": [
        "网页凭据留在私有会话",
        "不导出 cookie / key",
        "与 CLI token 分开管理"
      ]
    },
    {
      "id": "webVerify",
      "col": 2,
      "row": 1,
      "kind": "host",
      "title": "Console 身份核验",
      "lines": [
        "固定 Console 脚本指纹",
        "同一 context 的签名 Me 请求",
        "核对 user / tenancy / domain"
      ]
    },
    {
      "id": "webRead",
      "col": 3,
      "row": 1,
      "kind": "server",
      "title": "受限 Console 读取",
      "lines": [
        "browserRef 绑定原线程",
        "重验身份后读当前标题 / headings",
        "无任意导航、脚本或表单操作"
      ]
    }
  ],
  "edges": [
